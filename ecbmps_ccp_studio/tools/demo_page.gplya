; GPLY Assembly Demo — demo_page.gplya
; This example wires up a simple interactive page:
;   - A player sprite that can move with the d-pad
;   - A collectible coin that triggers a score increment and dialogue when touched
;   - A page-enter script that spawns both entities and shows a popup

; -----------------------------------------------------------------------
; Variables
; -----------------------------------------------------------------------

.variable score
    initial 0

.variable player_id
    initial 0

.variable coin_id
    initial 0

; -----------------------------------------------------------------------
; Entity definitions
; -----------------------------------------------------------------------

.entity player
    sprite  "assets/recraft/player.png"
    pos     80 100
    size    32 48
    timeline 8
    visible  1
    page     1

.entity coin
    sprite  "assets/recraft/coin.png"
    pos     200 110
    size    24 24
    timeline 4
    visible  1
    page     1

; -----------------------------------------------------------------------
; Hitbox definitions
; -----------------------------------------------------------------------

.hitbox player_body
    entity  player
    frame   all
    offset  2 0
    size    28 48
    kind    solid

.hitbox coin_pickup
    entity  coin
    frame   all
    offset  0 0
    size    24 24
    kind    trigger

; -----------------------------------------------------------------------
; Scripts
; -----------------------------------------------------------------------

; Called on PAGE_ENTER — spawn entities, show welcome popup
.script init_page
    push_int 0
    set_var  player_id

    push_int 0
    set_var  coin_id

    ; Spawn player entity
    ent_spawn  player
    set_var    player_id

    ; Spawn coin entity
    ent_spawn  coin
    set_var    coin_id

    show_popup "Use the d-pad to move. Collect the coin!"
    ret

; Called every FRAME_TICK — move player based on d-pad input
.script move_player
    ; Read d-pad bitmask: 1=up 2=down 4=left 8=right
    get_dpad                ; stack: [dpad]

    ; Check right (8)
    dup
    push_int 8
    and
    jmp_ifnot  .not_right
        get_var    player_id
        push_int   3
        push_int   0
        ent_move               ; move right by (3,0)
    label .not_right

    ; Check left (4)
    dup
    push_int 4
    and
    jmp_ifnot  .not_left
        get_var    player_id
        push_int   -3
        push_int   0
        ent_move               ; move left by (-3,0)
    label .not_left

    ; Check down (2)
    dup
    push_int 2
    and
    jmp_ifnot  .not_down
        get_var    player_id
        push_int   0
        push_int   3
        ent_move               ; move down by (0,3)
    label .not_down

    ; Check up (1)
    push_int 1
    and
    jmp_ifnot  .not_up
        get_var    player_id
        push_int   0
        push_int   -3
        ent_move               ; move up by (0,-3)
    label .not_up

    ret

; Called on COLLIDE between player and coin — increment score, hide coin
.script collect_coin
    ; Increment score
    get_var    score
    push_int   10
    add
    set_var    score

    ; Hide coin entity
    get_var    coin_id
    ent_hide

    ; Show dialogue
    show_dialogue "Coin collected! +10 points"
    ret

; Navigate to page 2 on button A press
.script go_next_page
    push_int  2
    goto_page
    ret

; -----------------------------------------------------------------------
; Scene definitions
; -----------------------------------------------------------------------

.scene main_scene
    entities 0 2
    bindings 0 4
    page     1
    flags    0

; -----------------------------------------------------------------------
; Event bindings
; -----------------------------------------------------------------------

; 1. Page enter fires init_page
.binding
    event   page_enter
    button  none
    source  any
    target  any
    script  init_page
    page    1

; 2. Every frame tick fires move_player
.binding
    event   frame_tick
    button  none
    source  any
    target  any
    script  move_player
    page    1

; 3. Collision between player and coin fires collect_coin
.binding
    event   collide
    button  none
    source  player
    target  coin
    script  collect_coin
    page    1

; 4. Button A press navigates to next page
.binding
    event   button_down
    button  a
    source  any
    target  any
    script  go_next_page
    page    1
