            }
          }
        ]
      },
      {
        "id": "ram_gate",
        "name": "Ram Gate",
        "safe_room": false,
        "danger": 2,
        "objective": "Use Salt Ram to break the reliquary barricade and prove that the boss reward changes stone, iron, and map state immediately, not abstractly.",
        "tutorial_tip": "This is the post-boss key test. The corridor only yields because Salt Ram can answer stone and iron with impact the moment you arrive.",
        "popup": {
          "template": "choice_shell",
          "title": "Post-Boss Payoff",
          "text": "Ram Gate proves that victory is a spatial verb, not a badge pinned to the HUD. The loop only closes once Salt Ram changes the barricade, the corridor, and your immediate options in the same breath that the sanctioner falls."
        },
        "palette": [
          "#362927",
          "#6f696b",
          "#b98a58"
        ],
        "parallax": [
          {
            "label": "gate ribs",
            "x": 28,
            "parallax": 0.18,
            "color": "#6b5149"
          },
          {
            "label": "breach sparks",
            "x": 76,
            "parallax": 0.42,
            "color": "#7e7f84"
          }
        ],
        "exits": {
          "left": "ember_nave",
          "right": {
            "room": "tutorial_sanctum",
            "requires": "salt_ram"
          }
        },
        "enemies": [
          {
            "name": "gate_revenant",
            "x": 62,
            "hp": 20,
            "aggression": 0.64,
            "armor": 1.6,
            "posture": 42
          }
        ]
      },
      {
        "id": "tutorial_sanctum",
        "name": "Tutorial Sanctum",
        "safe_room": true,
        "danger": 0,
        "objective": "Reach shelter with the full opening rite intact: rest, route, fight, rescue, breach, weave, and return with the roster still coherent under calmer light.",
        "tutorial_tip": "The core loop is established. From here the next pass can widen the map without changing the ash-reliquary identity, dark detail language, and cobalt-brass accents that already hold the route together.",
        "popup": {
          "template": "save_shell",
          "title": "Sanctum Record",
          "text": "Tutorial Sanctum closes the first rite in warmth rather than abstraction. Save here to preserve the roster, the milestones, and the proof that Aridfeihth already has a coherent opening world-feel instead of a disconnected tutorial shell pretending to be one."
