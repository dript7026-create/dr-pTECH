  "lore": {
    "codex": [
      {
        "id": "simiam_compact",
        "title": "SimIAM Compact",
        "text": "SimIAMs are not harvested powers. They are companion intelligences pulled back from a hostile frontier through rescue, stabilization, habitat care, and repeated proof that you can move through a bad place without reducing it to extraction."
      },
      {
        "id": "bond_tension_compact",
        "title": "Bond Tension",
        "text": "Bond tension is the shared stress of expedition, command, and survival under bad weather and worse architecture. Good play is preserving enough coherence for the roster to keep answering you even when the route becomes louder, darker, and less forgiving."
      },
      {
        "id": "bond_weave_compact",
        "title": "Bond Weave",
        "text": "Bond Weave is a finisher earned through discipline. It resolves boss states using the same verbs the player has been learning all along, only now under full ritual pressure with the room itself pressing in around the action."
      }
    ]
  }
}