{
  "format": {
    "id": "illusioninteractivegame",
    "extension": ".iig",
    "version": "1.0"
  },
  "metadata": {
    "title": "Aridfeihth Ash-Reliquary Demo",
    "project": "aridfeihth",
    "engine": "IllusionCanvasInteractive",
    "experience_goal": "A tense side-view pilgrimage through ash, oxidized brass, and wind-cut stone where rescue, pressure, and bond discipline all feed the same harsh frontier identity."
  },
  "integrations": {
    "egosphere": {
      "mode": "native-preferred",
      "focus": "encounter reading, pressure interpretation, and target emphasis",
      "agent_name": "aridfeihth_field_agent",
      "auto_build": true
    },
    "godai": {
      "difficulty_floor": 0.88,
      "difficulty_ceiling": 1.28,
      "focus": "omen pacing, mercy windows, and encounter escalation"
    },
    "orbengine": {
      "borrowed_capabilities": [
        "parallax layering",
        "pseudo3d floor staging",
        "room-depth composition"
      ]
    },
    "doengine": {
      "borrowed_capabilities": [
        "runtime bucket manifests",
        "deterministic asset intake",
        "automation-ready JSON outputs"
      ]
    }
  },
  "rendering": {
    "style": "2.5D pseudo3D 2D pixel-art hybrid",
    "camera": {
      "mode": "side_view_with_orbstyle_parallax",
      "horizon": 0.56
    },
    "palette_notes": [
      "ash-cobalt dusk over a weathered horizon",
      "oxidized brass trims and reliquary glints",
      "ember rust, kiln brown, and grave-grey ground planes"
    ]
  },
  "ui": {
    "skin_manifest": "../generated/ui/illusioncanvas_gothic_ui_skin.json"
  },
  "gameplay": {
    "core_loop": [
      "sortie from refuge",
      "stabilize hostile room",
      "rescue or pacify SimIAM",
      "unlock route or new verb",
      "return to refuge to rest and retune loadout"
    ],
    "combat": {
      "resource": "bond_tension",
      "finisher": "bond_weave",
      "player_identity": "light melee plus pet-directed encounter control"
    },
    "milestones": [
      {
        "id": "refuge_reset",
        "label": "Refuge hearth steadied",
        "criteria": {
          "rested_in_room": "latchspire_refuge"
        }
      },
      {
        "id": "mirror_newt_rescued",
        "label": "Mirror Newt trust earned",
        "criteria": {
          "rescued_pet": "mirror_newt",
          "requires_previous": [
            "refuge_reset"
          ]
        }
      },
      {
        "id": "latch_spider_rescued",
        "label": "Latch Spider anchored",
        "criteria": {
          "rescued_pet": "latch_spider",
          "requires_previous": [
            "mirror_newt_rescued"
          ]
        }
      },
      {
        "id": "switchyard_stabilized",
        "label": "Switchyard pressure broken",
        "criteria": {
          "room_clear_in_room": "ossuary_switchyard",
          "requires_previous": [
            "latch_spider_rescued"
          ]
        }
      },
      {
        "id": "ember_nave_weave",
        "label": "Ember sanction unwoven",
        "criteria": {
          "boss_defeated_in_room": "ember_nave",
          "requires_previous": [
            "switchyard_stabilized"
          ]
        }
      },
      {
        "id": "sanctum_return",
        "label": "Ash sanctum reclaimed",
        "criteria": {
          "entered_room": "tutorial_sanctum",
          "requires_previous": [
            "ember_nave_weave"
          ]
        }
      },
      {
        "id": "reliquary_bazaar_reached",
        "label": "Reliquary market reached",
        "criteria": {
          "entered_room": "reliquary_bazaar",
          "requires_previous": [
            "sanctum_return"
          ]
        }
      },
      {
        "id": "atlas_choir_reached",
        "label": "Atlas overlook opened",
        "criteria": {
          "entered_room": "atlas_choir",
          "requires_previous": [
            "reliquary_bazaar_reached"
          ]
        }
      }
    ],
    "persistence": {
      "save_file_suffix": ".save.json",
      "supports_manual_save": true,
      "supports_manual_load": true,
      "notes": "Use F5 to save and F9 to load from the runtime during the vertical slice."
    }
  },
  "world": {
    "start_room": "latchspire_refuge",
    "rooms": [
      {
        "id": "latchspire_refuge",
        "name": "Latchspire Refuge",
        "safe_room": true,
        "danger": 0,
        "objective": "Steady the refuge hearth, read the roster, and leave the tower with a bond profile fit for the ash corridor beyond.",
        "tutorial_tip": "Press R to rest beneath the brass warding lamps. Movement is on the arrow keys, and the first wind-cut route begins at the lamp-dark threshold to the right.",
        "popup": {
          "template": "sanctuary_shell",
          "title": "Refuge Litany",
          "text": "Latchspire Refuge is a soot-stained tower reliquary, not a neutral menu room. Rest under the brass lamps, study the dark seams in the stone, then step out with Glass Beak on Burst and Wind Kite on Chorus so the wasteland grammar begins in full voice."
        },
        "palette": [
          "#4a3a34",
          "#5a6678",
          "#b8924f"
        ],
        "parallax": [
          {
            "label": "wind towers",
            "x": 18,
            "parallax": 0.28,
            "color": "#645850"
          },
          {
            "label": "nursery lanterns",
            "x": 72,
            "parallax": 0.42,
            "color": "#6c7480"
          }
        ],
        "layout": {
          "platforms": [
            {
              "id": "refuge_floor",
              "x1": 0,
              "x2": 100,
              "y": 0,
              "color": "#6b6158"
            },
            {
              "id": "refuge_perch",
              "x1": 58,
              "x2": 88,
              "y": 3,
              "color": "#7e6f5b"
            }
          ],
          "encounter_zones": [
            {
              "id": "refuge_threshold",
              "x1": 82,
              "x2": 100,
              "pressure_bonus": 0.02,
              "event": "The threshold opens from lampwarm safety into red dust and moving iron."
            }
          ]
        },
        "exits": {
          "right": "choir_stair"
        },
        "enemies": []
      },
      {
        "id": "choir_stair",
        "name": "Choir Stair",
        "safe_room": false,
        "danger": 1,
        "objective": "Learn dodge timing and Chorus discipline while the broken stair throws grit, shadow, and bad footing across your path.",
        "tutorial_tip": "Press Space to dodge through pressure and C to toggle Wind Kite. Chorus buys breathing room, but the ash wind and worn stair edges make wasted tension expensive.",
        "popup": {
          "template": "tutorial_tip_shell",
          "title": "Crosswind Lesson",
          "text": "Choir Stair is where the pilgrimage first stops being clean. Wind Kite buys safety, but only if you feel the drain early, read the broken steps and hanging dark shapes correctly, and cut Chorus before the brass thread frays into waste."
        },
        "palette": [
          "#3f342f",
          "#586273",
          "#ad8350"
        ],
        "parallax": [
          {
            "label": "bell braces",
            "x": 22,
            "parallax": 0.2,
            "color": "#5d5048"
          },
          {
            "label": "stair lanterns",
            "x": 76,
            "parallax": 0.4,
            "color": "#75767d"
          }
        ],
        "layout": {
          "platforms": [
            {
              "id": "choir_floor",
              "x1": 0,
              "x2": 100,
              "y": 0,
              "color": "#66554d"
            },
            {
              "id": "choir_mid_step",
              "x1": 18,
              "x2": 42,
              "y": 2,
              "color": "#79665c"
            },
            {
              "id": "choir_high_step",
              "x1": 48,
              "x2": 74,
              "y": 4,
              "color": "#8c7568"
            }
          ],
          "hazards": [
            {
              "id": "choir_shards",
              "x1": 76,
              "x2": 90,
              "y": 0,
              "damage": 4,
              "tension": 3,
              "color": "#b45e46",
              "event": "Razor grit skates down the stair and scores the route line."
            }
          ],
          "encounter_zones": [
            {
              "id": "choir_crosswind",
              "x1": 24,
              "x2": 70,
              "pressure_bonus": 0.05,
              "tension_bonus": 0.15,
              "color": "#6a4d45",
              "event": "A crosswind pocket turns the stair into the first true pressure lane."
            }
          ]
        },
        "exits": {
          "left": "latchspire_refuge",
          "right": "glasswind_causeway"
        },
        "enemies": [
          {
            "name": "choir_watcher",
            "x": 58,
            "hp": 14,
            "aggression": 0.5,
            "armor": 1.0,
            "posture": 38
          }
        ]
      },
      {
        "id": "glasswind_causeway",
        "name": "Glasswind Causeway",
        "safe_room": false,
        "danger": 2,
        "objective": "Break the bridge predators, then rescue Mirror Newt so the route can bend through cobalt reflections, riveted iron, and exposed wind instead of brute force.",
        "tutorial_tip": "Use Z for melee and X for Glass Beak. Burst commands crack posture faster than chip damage, which matters once the causeway starts hunting back through the open span.",
        "popup": {
          "template": "dialogue_shell",
          "title": "Field Note: Mirror Newt",
          "text": "Mirror Newt is the first companion the wasteland gives back on trust alone. The route does not widen because you harvested a corpse. It widens because you calmed a living intelligence on a violent span of rivets, cables, cobalt shards, and bad air."
        },
        "palette": [
          "#4a302d",
          "#55657a",
          "#b4573f"
        ],
        "parallax": [
          {
            "label": "shard sails",
            "x": 28,
            "parallax": 0.22,
            "color": "#6a4f45"
          },
          {
            "label": "bridge ribs",
            "x": 76,
            "parallax": 0.46,
            "color": "#73757a"
          }
        ],
        "layout": {
          "platforms": [
            {
              "id": "causeway_floor",
              "x1": 0,
              "x2": 100,
              "y": 0,
              "color": "#6a564c"
            },
            {
              "id": "causeway_span",
              "x1": 34,
              "x2": 64,
              "y": 3,
              "color": "#7b7d82"
            }
          ],
          "hazards": [
            {
              "id": "causeway_drop",
              "x1": 18,
              "x2": 30,
              "y": 0,
              "damage": 5,
              "tension": 4,
              "color": "#a74a3d",
              "event": "The broken lip of the causeway chews at every careless step."
            }
          ],
          "encounter_zones": [
            {
              "id": "causeway_predator_lane",
              "x1": 40,
              "x2": 88,
              "pressure_bonus": 0.08,
              "tension_bonus": 0.2,
              "color": "#7a5648",
              "event": "Bridge predators lock onto the expedition line and force the march into open view."
            }
          ]
        },
        "exits": {
          "left": "latchspire_refuge",
          "right": {
            "room": "mirror_cistern",
            "requires": "mirror_newt"
          }
        },
        "rescue": {
          "pet": "mirror_newt",
          "x": 78,
          "y": 0
        },
        "enemies": [
          {
