            "posture": 46
          },
          {
            "name": "salt_raider",
            "x": 72,
            "hp": 22,
            "aggression": 0.7,
            "armor": 1.3,
            "posture": 50
          }
        ]
      },
      {
        "id": "mirror_cistern",
        "name": "Mirror Cistern",
        "safe_room": false,
        "danger": 3,
        "objective": "Read the mirrored kill-lines in the cistern and free Latch Spider from drowned clockwork before the chamber folds in on itself.",
        "tutorial_tip": "Reed Fin is a Crest pet. This room is about noticing quiet protection while wet stone, red reflections, and cobalt glare try to convince you the pressure is larger than it is.",
        "popup": {
          "template": "codex_shell",
          "title": "Codex: Crest Reading",
          "text": "Mirror Cistern proves that some of the roster works like shelter rather than spectacle. Reed Fin buys recovery in the background, and the player is expected to feel that steadiness while wet stone, drowned machinery, and cobalt light keep lying about the room."
        },
        "palette": [
          "#43332e",
          "#66707a",
          "#b08969"
        ],
        "parallax": [
          {
            "label": "reflective ribs",
            "x": 24,
            "parallax": 0.26,
            "color": "#6e5a50"
          },
          {
            "label": "water clocks",
            "x": 84,
            "parallax": 0.48,
            "color": "#7c8188"
          }
        ],
        "layout": {
          "platforms": [
            {
              "id": "cistern_floor",
              "x1": 0,
              "x2": 100,
              "y": 0,
              "color": "#63544d"
            },
            {
              "id": "cistern_clocklip",
              "x1": 54,
              "x2": 86,
              "y": 4,
              "color": "#8a837c"
            }
          ],
          "encounter_zones": [
            {
              "id": "cistern_reflection_field",
              "x1": 30,
              "x2": 82,
              "pressure_bonus": 0.09,
              "tension_bonus": 0.16,
              "color": "#70584d",
              "event": "Reflection lines multiply the danger until the chamber is read for what it is, not what it pretends to be."
            }
          ]
        },
        "exits": {
          "left": "glasswind_causeway",
          "right": {
            "room": "scribe_gullet",
            "requires": "latch_spider"
          }
        },
        "rescue": {
          "pet": "latch_spider",
          "x": 80,
          "y": 4
        },
        "enemies": [
          {
            "name": "mirror_eel",
            "x": 48,
            "hp": 24,
            "aggression": 0.76,
            "armor": 1.5,
            "posture": 56
          },
          {
            "name": "husk_archivist",
            "x": 70,
            "hp": 26,
            "aggression": 0.68,
            "armor": 1.9,
            "posture": 60
          }
        ]
      },
      {
        "id": "scribe_gullet",
        "name": "Scribe Gullet",
        "safe_room": true,
        "danger": 1,
        "objective": "Use the soot-quiet pocket to settle bond tension, then step from ledgers, cages, and braziers into the harsher iron logic of the switchyard.",
        "tutorial_tip": "This is a mid-run calm pocket. Rest again if bond tension is spiking before the next hard gate starts speaking in sparks and locking rails.",
        "popup": {
          "template": "journal_shell",
          "title": "Ash Journal",
          "text": "Scribe Gullet lets the route breathe without turning soft. Between cages, braziers, and ash-marked walls, its quiet proves that tension management is a rhythm authored into the pilgrimage, not a hidden tax running under the fiction."
        },
        "palette": [
          "#3b302d",
          "#6b6664",
          "#9a7f62"
        ],
        "parallax": [
          {
            "label": "scribe cages",
            "x": 24,
            "parallax": 0.24,
            "color": "#60534c"
          },
          {
            "label": "ink braziers",
            "x": 80,
            "parallax": 0.46,
            "color": "#7b7375"
          }
        ],
        "exits": {
          "left": "mirror_cistern",
          "right": "ossuary_switchyard"
        },
        "enemies": []
      },
      {
        "id": "ossuary_switchyard",
        "name": "Ossuary Switchyard",
        "safe_room": false,
        "danger": 4,
        "objective": "Break the switchyard bailiff and wrench the signal lane open into the Ember Nave by force of presence, not momentum, while the rails keep spitting back.",
        "tutorial_tip": "Clear-gated exits matter here. The iron lane does not yield until the active threat has been fully broken out of the room and the rails stop answering to it.",
        "popup": {
          "template": "quest_shell",
          "title": "Route Condition",
          "text": "The Switchyard is where Aridfeihth stops negotiating. Route permission is spatial and stateful, not a checklist. If the local threat still owns the rails, sparks, and signal ribs, the corridor is not yours yet."
        },
        "palette": [
          "#352a28",
          "#716968",
          "#b45d48"
        ],
        "parallax": [
          {
            "label": "rail bones",
            "x": 18,
            "parallax": 0.2,
            "color": "#69554f"
          },
          {
            "label": "signal pyres",
            "x": 68,
            "parallax": 0.44,
            "color": "#7b7e86"
          }
        ],
        "layout": {
          "platforms": [
            {
              "id": "switchyard_floor",
              "x1": 0,
              "x2": 100,
              "y": 0,
              "color": "#5d514d"
            },
            {
              "id": "switchyard_signal_rib",
              "x1": 44,
              "x2": 70,
              "y": 3,
              "color": "#80716b"
            }
          ],
          "hazards": [
            {
              "id": "switchyard_rails",
              "x1": 72,
              "x2": 86,
              "y": 0,
              "damage": 5,
              "tension": 4,
              "color": "#9d473c",
              "event": "Bone rails spit sparks underfoot and punish hesitation."
            }
          ],
          "encounter_zones": [
            {
              "id": "switchyard_lock_zone",
              "x1": 48,
              "x2": 88,
              "pressure_bonus": 0.1,
              "tension_bonus": 0.22,
              "color": "#734f46",
              "event": "The switchyard clamps shut until the bailiff is fully broken and the line stops answering to him."
            }
          ]
        },
        "exits": {
          "left": "mirror_cistern",
          "right": {
            "room": "ember_nave",
            "requires_room_clear": true
          }
        },
        "enemies": [
          {
            "name": "switchyard_bailiff",
            "x": 60,
            "hp": 38,
            "aggression": 0.82,
            "armor": 2.2,
            "posture": 68
          }
        ]
      },
      {
        "id": "ember_nave",
        "name": "Ember Nave",
        "safe_room": false,
        "danger": 5,
        "objective": "Root the sanctioner in the ash-lit nave, sustain Wind Kite through the heat, and end the rite with a full bond weave in front of the altar.",
        "tutorial_tip": "Lower posture, keep Wind Kite active, make sure the boss is rooted, then press V for Bond Weave when the brass window opens and the altar line is clear.",
        "popup": {
          "template": "death_shell",
          "title": "Boss Resolution",
          "text": "Ember Nave refuses brute damage as a complete answer. The sanctioner only yields when the room grammar is honored in sequence: posture broken, root secured, Chorus held, then Bond Weave through the opening while the pillars, gutters, and altar all stay under control."
        },
        "palette": [
          "#392826",
          "#6c6668",
          "#c66a48"
        ],
        "parallax": [
          {
            "label": "chain braziers",
            "x": 18,
            "parallax": 0.22,
            "color": "#7a4a3e"
          },
          {
            "label": "ash vault",
            "x": 78,
            "parallax": 0.45,
            "color": "#6f7077"
          }
        ],
        "layout": {
          "platforms": [
            {
              "id": "nave_floor",
              "x1": 0,
              "x2": 100,
              "y": 0,
              "color": "#5f4a45"
            },
            {
              "id": "nave_weave_altar",
              "x1": 52,
              "x2": 76,
              "y": 3,
              "color": "#8b796e"
            }
          ],
          "hazards": [
            {
              "id": "nave_ember_gutter",
              "x1": 20,
              "x2": 32,
              "y": 0,
              "damage": 6,
              "tension": 5,
              "color": "#b84f38",
              "event": "Ember gutters flare along the nave floor and force the weave to happen under heat."
            }
          ],
          "encounter_zones": [
            {
              "id": "nave_sanction_field",
              "x1": 46,
              "x2": 88,
              "pressure_bonus": 0.12,
              "tension_bonus": 0.24,
              "color": "#825243",
              "event": "The sanction field demands a precise rooted weave window and punishes every mistimed reach."
            }
          ]
        },
        "exits": {
          "left": "ossuary_switchyard",
          "right": {
            "room": "ram_gate",
            "requires_room_clear": true
          }
        },
        "bond_weave": {
          "posture_at_most": 26,
          "requires_chorus": "wind_kite",
